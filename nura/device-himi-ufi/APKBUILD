# Local device package (not upstream). DTB built from ~/3d-modem/nura/msm8916-himi-ufi-esim.dts
# against msm8916-mainline/linux v6.12.1-msm8916.
pkgname=device-himi-ufi
pkgdesc="HiMiLink 4G UFI LTE dongle (eSIM-switch revision)"
pkgver=1
pkgrel=4
url="https://postmarketos.org"
license="GPL"
arch="aarch64"
options="!check !archcheck"
install="$pkgname.post-install"
depends="
	linux-postmarketos-qcom-msm8916
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	soc-qcom-msm8916
	soc-qcom-msm8916-rproc
"
makedepends="devicepkg-dev go"
source="deviceinfo kernel-cmdline.conf msm8916-himi-ufi-esim.dtb
	diag_nv.go diag_nv.mod diag-bind himi-ok-guard modem-watchdog sim-autounlock
	himi-ok-guard.service modem-watchdog.service sim-autounlock.service watchdog.conf
	lte-dongle-webapp.tar.gz lte-dongle.service lte-dongle-sysusers.conf lte-dongle-tmpfiles.conf
	50-lte-dongle.rules 60_lte_dongle.nft 90-lte-dongle-led.rules uim-retry.conf"

build() {
	devicepkg_build $startdir $pkgname

	# diag_nv: writes modem NV item 2500 = "HiMI_OK" (see himi-ok-guard). Stdlib only.
	mkdir -p "$builddir"
	cp "$srcdir"/diag_nv.go "$builddir"/main.go
	cp "$srcdir"/diag_nv.mod "$builddir"/go.mod
	(cd "$builddir" && CGO_ENABLED=0 go build -ldflags="-s -w" -o diag_nv .)

	# lte-dongle: the web UI (sources in ~/3d-modem/webapp, stdlib only). go.mod pins a patch
	# release that Alpine's go may not match; GOTOOLCHAIN=local forbids downloading one.
	mkdir -p "$builddir"/webapp
	tar xzf "$srcdir"/lte-dongle-webapp.tar.gz -C "$builddir"/webapp
	(cd "$builddir"/webapp && sed -i 's/^go .*/go 1.25/' go.mod &&
		GOTOOLCHAIN=local CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o ../lte-dongle .)
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/msm8916-himi-ufi-esim.dtb \
		"$pkgdir"/usr/share/dtb/msm8916-himi-ufi-esim.dtb

	# Modem stability: stops the ~15 min HiMiLink firmware crash (NV 2500 must be "HiMI_OK"),
	# soft-restarts the modem if it crashes anyway, unlocks the SIM, feeds the HW watchdog.
	install -Dm755 "$builddir"/diag_nv "$pkgdir"/usr/bin/diag_nv
	for f in diag-bind himi-ok-guard modem-watchdog sim-autounlock; do
		install -Dm755 "$srcdir"/$f "$pkgdir"/usr/sbin/$f
	done
	for u in himi-ok-guard modem-watchdog sim-autounlock; do
		install -Dm644 "$srcdir"/$u.service "$pkgdir"/etc/systemd/system/$u.service
		install -d "$pkgdir"/etc/systemd/system/multi-user.target.wants
		ln -s ../$u.service "$pkgdir"/etc/systemd/system/multi-user.target.wants/$u.service
	done
	install -Dm644 "$srcdir"/watchdog.conf "$pkgdir"/etc/systemd/system.conf.d/watchdog.conf

	# Web UI on :8080 as unprivileged user lte-dongle. Not enabled here: it needs a password
	# file first (see README), then `systemctl enable --now lte-dongle`.
	install -Dm755 "$builddir"/lte-dongle "$pkgdir"/usr/bin/lte-dongle
	install -Dm644 "$srcdir"/lte-dongle.service "$pkgdir"/etc/systemd/system/lte-dongle.service
	install -Dm644 "$srcdir"/lte-dongle-sysusers.conf "$pkgdir"/etc/sysusers.d/lte-dongle.conf
	install -Dm644 "$srcdir"/lte-dongle-tmpfiles.conf "$pkgdir"/etc/tmpfiles.d/lte-dongle.conf
	install -Dm644 "$srcdir"/50-lte-dongle.rules "$pkgdir"/etc/polkit-1/rules.d/50-lte-dongle.rules
	install -Dm644 "$srcdir"/60_lte_dongle.nft "$pkgdir"/etc/nftables.d/60_lte_dongle.nft
	install -Dm644 "$srcdir"/90-lte-dongle-led.rules "$pkgdir"/etc/udev/rules.d/90-lte-dongle-led.rules
	install -Dm644 "$srcdir"/uim-retry.conf \
		"$pkgdir"/etc/systemd/system/msm-modem-uim-selection.service.d/retry.conf
}

